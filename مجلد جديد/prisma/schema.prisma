datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id           String      @id @default(uuid())
  code         String      @unique
  nameAr       String
  nameEn       String
  category     String
  ifrsStandard String?
  currency     String      @default("LYD")
  isCapital    Boolean     @default(false)
  parentId     String?
  parent       Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]   @relation("AccountHierarchy")
  custodyItems CustodyItem[]
  createdAt    DateTime    @default(now())
}

model CustodyItem {
  id            String   @id @default(uuid())
  itemNo        Int
  description   String
  amountLYD     Float
  amountUSD     Float
  exchangeRate  Float    @default(8.53)
  hasInvoice    Boolean  @default(true)
  status        String   @default("APPROVED")
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id])
  createdAt     DateTime @default(now())
}

model CWIPComponent {
  id             String   @id @default(uuid())
  code           String   @unique
  nameAr         String
  usefulLifeYears Int     @default(20)
  totalCostLYD   Float    @default(0.0)
  totalCostUSD   Float    @default(0.0)
  isCapitalized  Boolean  @default(false)
  createdAt      DateTime @default(now())
}